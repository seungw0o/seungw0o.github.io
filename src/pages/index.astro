---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
			}
			ul {
				display: flex;
				flex-direction: column;
				gap: 2.5rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				border-bottom: 1px solid rgba(var(--ink-soft), 0.3);
				padding-bottom: 2rem;
			}
			ul li:last-child {
				border-bottom: none;
			}
			ul li a {
				display: block;
				text-decoration: none;
				background: none;
			}
			.title {
				margin: 0 0 0.3rem 0;
				color: rgb(var(--ink));
				font-size: 2rem;
				line-height: 1.2;
				display: inline-block;
				/* 클릭 가능함이 보이도록 상시 밑줄 */
				text-decoration: underline;
				text-decoration-color: rgba(var(--ink-soft), 0.5);
				text-decoration-thickness: 1.5px;
				text-underline-offset: 6px;
			}
			.description {
				margin: 0 0 0.5rem 0;
				color: rgb(var(--ink-soft));
				font-size: 1rem;
				line-height: 1.6;
			}
			.date {
				margin: 0;
				color: rgb(var(--ink-soft));
				font-size: 1.2rem;
				font-family: var(--font-hand-title);
			}
			ul li a:hover .title {
				text-decoration-color: var(--accent);
				text-decoration-thickness: 2px;
			}
			.intro {
				margin-bottom: 3.5rem;
				padding-bottom: 2.5rem;
				border-bottom: 1px solid rgba(var(--ink-soft), 0.3);
			}
			.intro h1 {
				font-size: 2.4em;
				margin-bottom: 0.4rem;
			}
			.intro p {
				margin: 0 0 0.4em 0;
				color: rgb(var(--ink-soft));
				line-height: 1.7;
			}
			.intro-links {
				margin-top: 0.8em;
				font-family: var(--font-hand-title);
				font-size: 1.15em;
			}
			.intro-links a {
				text-decoration: none;
			}
			.intro-links a:hover {
				text-decoration: underline;
				text-decoration-thickness: 2px;
				text-underline-offset: 5px;
			}
			.intro-links span {
				color: rgb(var(--ink-soft));
				margin: 0 0.5em;
			}
			.recent-label {
				font-family: var(--font-hand-title);
				font-size: 1.6em;
				margin-bottom: 1.5rem;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="intro">
				<h1>{'Frontend Engineer 정승우입니다.'}</h1>
				<p>{'개발을 하며 경험한 내용과 알게 된 사실을 블로그로 정리하고 있습니다.'}</p>
				<p class="intro-links">
					<a href="mailto:jung.sw.dev@gmail.com">Email</a><span>·</span><a
						href="https://www.linkedin.com/in/seungw0o/"
						target="_blank">LinkedIn</a
					><span>·</span><a href="https://github.com/seungw0o" target="_blank">GitHub</a>
				</p>
			</section>
			<section>
				<p class="recent-label">최근 글</p>
				<ul>
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									<h4 class="title">{post.data.title}</h4>
									<p class="description">{post.data.description}</p>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
