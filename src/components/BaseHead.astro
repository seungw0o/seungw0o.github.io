---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import '../styles/fonts.generated.css';
import type { ImageMetadata } from 'astro';
import fontManifest from '../assets/fonts/generated/manifest.json';
import { GOATCOUNTER_CODE, SITE_TITLE } from '../consts';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	/** OpenGraph 썸네일 경로. 기본값은 빌드 타임에 생성되는 사이트 공용 카드다. */
	ogImage?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image, ogImage } = Astro.props;
const ogImageURL = new URL(ogImage ?? image?.src ?? '/og/site.png', Astro.url);
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<!-- 흰 모눈종이가 디자인 정체성이라 다크 팔레트를 두지 않는다.
     선언이 없으면 Chrome 자동 다크(Android 어두운 테마 등)가 페이지를 임의로
     뒤집는데, 반투명 형광펜이 검은 배경 위에서 탁한 얼룩이 된다. -->
<meta name="color-scheme" content="only light" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- 본문: IBM Plex Sans KR, 손글씨 포인트: Nanum Pen Script.
     빌드 타임 서브셋(scripts/build-fonts.mjs)을 self-host한다. -->
<link rel="preload" href={fontManifest['plex-400']} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={fontManifest['pen-400']} as="font" type="font/woff2" crossorigin />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- 검색결과 사이트명. github.io 서브도메인이라 선언이 없으면 구글이
     모체 도메인의 이름("GitHub")을 가져다 쓴다. -->
<script
	type="application/ld+json"
	is:inline
	set:html={JSON.stringify({
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		name: SITE_TITLE,
		url: Astro.site,
	})}
/>

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageURL} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />

<!-- 방문 집계(GoatCounter). 쿠키를 쓰지 않아 동의 배너가 필요하지 않다. -->
{
	import.meta.env.PROD && GOATCOUNTER_CODE && (
		<script
			is:inline
			async
			data-goatcounter={`https://${GOATCOUNTER_CODE}.goatcounter.com/count`}
			src="https://gc.zgo.at/count.js"
		/>
	)
}
