---
/**
 * giscus 댓글. 글마다 GitHub Discussions(Announcements 카테고리)의 스레드 하나에 연결된다.
 * 매핑 기준이 pathname이라 파일명(=URL)을 바꾸면 기존 댓글과 연결이 끊긴다.
 */
---

<section class="comments" aria-label="댓글">
	<script
		is:inline
		src="https://giscus.app/client.js"
		data-repo="seungw0o/seungw0o.github.io"
		data-repo-id="R_kgDOT87WBg"
		data-category="Announcements"
		data-category-id="DIC_kwDOT87WBs4DJOr8"
		data-mapping="pathname"
		data-strict="1"
		data-reactions-enabled="1"
		data-emit-metadata="0"
		data-input-position="top"
		data-theme="light"
		data-lang="ko"
		data-loading="lazy"
		crossorigin="anonymous"
		async></script>
</section>

<style>
	.comments {
		margin-top: 3em;
		padding-top: 2em;
		border-top: 1px solid rgba(var(--ink-soft), 0.35);
	}
</style>
